digraph ERD {
  graph [rankdir=LR, fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.9, label="Albion Basket OLTP schema (shop) - 3NF", labelloc=t, fontsize=18];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [arrowhead=crow, arrowtail=tee, dir=both, color="#1F3A68"];
  regions [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td bgcolor="#1F3A68"><font color="white"><b>regions</b></font></td></tr><tr><td align="left"><b>PK</b> postcode_area</td></tr><tr><td align="left">region</td></tr><tr><td align="left">nation  <i>CHECK</i></td></tr><tr><td align="left">delivery_band  <i>CHECK</i></td></tr></table>>];
  addresses [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td bgcolor="#1F3A68"><font color="white"><b>addresses</b></font></td></tr><tr><td align="left"><b>PK</b> address_id</td></tr><tr><td align="left">postcode  <i>UNIQUE, CHECK regex</i></td></tr><tr><td align="left"><b>FK</b> postcode_area</td></tr></table>>];
  customers [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td bgcolor="#1F3A68"><font color="white"><b>customers</b></font></td></tr><tr><td align="left"><b>PK</b> customer_id</td></tr><tr><td align="left">full_name</td></tr><tr><td align="left">email  <i>UNIQUE</i></td></tr><tr><td align="left"><b>FK</b> home_address_id</td></tr><tr><td align="left">signup_date</td></tr></table>>];
  orders [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td bgcolor="#F28C28"><b>orders</b></td></tr><tr><td align="left"><b>PK</b> order_id</td></tr><tr><td align="left"><b>FK</b> customer_id</td></tr><tr><td align="left"><b>FK</b> delivery_address_id</td></tr><tr><td align="left">order_ts  <i>timestamptz</i></td></tr><tr><td align="left">channel  <i>CHECK</i></td></tr><tr><td align="left">total_gbp  <i>CHECK &gt;= 0</i></td></tr><tr><td align="left">vat_gbp  <i>CHECK &lt;= total</i></td></tr><tr><td align="left">delivery_fee_gbp</td></tr></table>>];
  order_items [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td bgcolor="#F28C28"><b>order_items</b></td></tr><tr><td align="left"><b>PK/FK</b> order_id</td></tr><tr><td align="left"><b>PK/FK</b> sku</td></tr><tr><td align="left">quantity  <i>CHECK &gt; 0</i></td></tr><tr><td align="left">unit_price_gbp</td></tr></table>>];
  products [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td bgcolor="#1F3A68"><font color="white"><b>products</b></font></td></tr><tr><td align="left"><b>PK</b> sku</td></tr><tr><td align="left">name</td></tr><tr><td align="left">category</td></tr><tr><td align="left"><b>FK</b> vat_band</td></tr><tr><td align="left">unit_price_gbp</td></tr></table>>];
  vat_rates [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td bgcolor="#1F3A68"><font color="white"><b>vat_rates</b></font></td></tr><tr><td align="left"><b>PK</b> vat_band</td></tr><tr><td align="left">rate</td></tr></table>>];
  regions -> addresses; addresses -> customers [label=" home"]; addresses -> orders [label=" ships to"];
  customers -> orders; orders -> order_items; products -> order_items; vat_rates -> products;
}
